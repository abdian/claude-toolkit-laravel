# Default: normalize to LF in the repo, let git decide on checkout.
* text=auto eol=lf

# These MUST stay LF — CRLF breaks the shebang on Linux and macOS.
*.sh        text eol=lf
*.py        text eol=lf

# Windows-native, keep CRLF locally.
*.ps1       text eol=crlf

# Binary — never touch.
*.png       binary
*.ico       binary
*.woff      binary
*.woff2     binary
